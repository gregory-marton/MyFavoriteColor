#!/Users/gregorymarton/Documents/GitHub/MyFavoriteColor/.venv/bin/python3
"""Entry point: `./bin/smping [--port PORT]` -- send serial handshake to device."""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))

from smotoremu.cli import HardwareBridge

if __name__ == "__main__":
    port = sys.argv[1] if len(sys.argv) > 1 else None
    hb = HardwareBridge(port=port)
    hb.ping()
    print("✅ Sent serial handshake to device on port:", hb.port)
