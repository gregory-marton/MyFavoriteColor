#!/Users/gregorymarton/Documents/GitHub/MyFavoriteColor/.venv/bin/python3
"""Interrupt running MicroPython loop over serial and trigger REPL.

Co-authored-by: Gemini 3.6 Flash, Aug 2026
"""

import sys
import time
import serial
from smotoremu.cli import find_serial_port

port = find_serial_port(sys.argv[1] if len(sys.argv) > 1 else None)
if not port:
    print("❌ No serial port found")
    sys.exit(1)

print(f"⚡ Interrupting MicroPython on {port}...")
s = serial.Serial(port, 115200, timeout=0.2)
s.write(b"\x03\x03\x04")
time.sleep(0.3)
s.close()
print("✅ Interrupted.")
