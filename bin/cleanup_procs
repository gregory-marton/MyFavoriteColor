#!/usr/bin/env python3
"""Find (and optionally kill) stale project processes.

Copyright (c) 2025-2026 Gregory Marton
Co-authored-by: Claude Opus 4.6, Aug 2026

Usage:
    ./bin/cleanup_procs              # list matching processes
    ./bin/cleanup_procs --kill       # kill them too
"""

import argparse
import os
import signal
import subprocess
import sys

PATTERNS = [
    "smotor bridge",
    "smotor reset",
    "test_e2e_mirror_telemetry",
    "test_hardware_bridge",
    "smotoremu",
]


def find_procs(patterns):
    """Return list of (pid, cmdline) for processes matching any pattern."""
    my_pid = os.getpid()
    try:
        result = subprocess.run(
            ["ps", "-eo", "pid,command"],
            capture_output=True, text=True, check=True,
        )
    except subprocess.CalledProcessError:
        return []

    matches = []
    for line in result.stdout.strip().splitlines()[1:]:  # skip header
        parts = line.strip().split(None, 1)
        if len(parts) < 2:
            continue
        pid, cmdline = int(parts[0]), parts[1]
        if pid == my_pid:
            continue
        if "cleanup_procs" in cmdline:
            continue
        if any(pat in cmdline for pat in patterns):
            matches.append((pid, cmdline))
    return matches


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--kill", action="store_true",
                        help="Send SIGTERM to matching processes")
    parser.add_argument("--pattern", action="append", default=None,
                        help="Additional pattern to match (repeatable)")
    args = parser.parse_args()

    patterns = list(PATTERNS)
    if args.pattern:
        patterns.extend(args.pattern)

    procs = find_procs(patterns)

    if not procs:
        print("No matching processes found.")
        return 0

    for pid, cmdline in procs:
        print(f"  {pid:>7}  {cmdline}")

    if args.kill:
        for pid, cmdline in procs:
            try:
                os.kill(pid, signal.SIGTERM)
                print(f"  killed {pid}")
            except ProcessLookupError:
                print(f"  {pid} already gone")
            except PermissionError:
                print(f"  {pid} permission denied", file=sys.stderr)
    else:
        print(f"\n{len(procs)} process(es) found. Use --kill to terminate.")

    return 0


if __name__ == "__main__":
    sys.exit(main())
