#!/bin/bash
# Upload only the physical-device live mirror support files.
# Co-authored-by: GPT-5, Aug 2026

set -euo pipefail

MPREMOTE_BIN="${MPREMOTE_BIN:-.venv/bin/mpremote}"

for mirror_file in boot.py smirror.py adxl345.py sensors.py; do
    echo "Uploading ${mirror_file}"
    "${MPREMOTE_BIN}" cp "${mirror_file}" :
done

"${MPREMOTE_BIN}" reset
echo "Mirror firmware deployed."
