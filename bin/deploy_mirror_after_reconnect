#!/bin/bash
# Wait for one USB disconnect/reconnect, then upload before the mirror loop.
# Co-authored-by: GPT-5, Aug 2026
# Co-authored-by: GPT-5.6-Sol-high, Aug 2026

set -euo pipefail

MPREMOTE_BIN="${MPREMOTE_BIN:-.venv/bin/mpremote}"

while compgen -G "/dev/cu.usbmodem*" >/dev/null; do
    sleep 0.05
done
echo "SmartMotor disconnected; waiting for reconnect..."

while ! compgen -G "/dev/cu.usbmodem*" >/dev/null; do
    sleep 0.05
done
echo "SmartMotor reconnected; uploading mirror firmware now."

for mirror_file in boot.py mirror.py mirror_main.py adxl345.py ssd1306.py servo.py; do
    "${MPREMOTE_BIN}" cp "${mirror_file}" :
done

"${MPREMOTE_BIN}" cp mirror_main.py :main.py

"${MPREMOTE_BIN}" exec "import os; os.remove('smirror.py')"

"${MPREMOTE_BIN}" reset
echo "Mirror firmware deployed."
